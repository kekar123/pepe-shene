# База данных PostgreSQL
DATABASE_URL=sqlite:///pepe_database.db

# Или если используете SQLite для тестов:
# DATABASE_URL=sqlite:///pepe_database.db

# Настройки приложения
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16MB
DEBUG=True
SECRET_KEY=your-secret-key-here

# Пути к данным
INPUT_EXCEL_FOLDER=input_excel
OUTPUT_JSON_FOLDER=output_json
ANALYSIS_RESULTS_FOLDER=analysis_results

# Ollama settings (local Llama model)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=warehouse-ru
CHAT_USE_OLLAMA=1
# auto = LLM for any question (general explanations + data paraphrase)
CHAT_LLM_MODE=auto
CHAT_USE_COMBINED_JSON=1
# Set to 1 to force LLM answers for all queries (not recommended for numeric-only queries)
CHAT_FORCE_OLLAMA=0
